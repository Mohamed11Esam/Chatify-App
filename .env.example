# ==============================================================================
# Chatify-App Environment Configuration Template
# Duplicate this file to .env (for local dev) or enter these variables in your
# cloud provider dashboard (Render / Koyeb / etc.)
# ==============================================================================

# Node Environment ('production' for live deployment, 'development' for local)
NODE_ENV=production

# Server Port (Render & Koyeb automatically inject PORT; fallback is 3000)
PORT=3000

# Full Public URL of the deployed app (e.g., https://chatify-app.onrender.com)
# Used for CORS validation and clickable links in welcome emails. Do NOT include a trailing slash.
CLIENT_URL=https://your-chatify-app.onrender.com

# ------------------------------------------------------------------------------
# Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Optional MongoDB retry and timeout tuning
DB_CONNECT_RETRIES=5
DB_CONNECT_BASE_DELAY_MS=1000
DB_SERVER_SELECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens (generate via `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_random_jwt_key_here

# ------------------------------------------------------------------------------
# Cloudinary (Media / Profile & Chat Image Uploads)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Arcjet (Security, Bot Protection & Rate Limiting)
# ------------------------------------------------------------------------------
# Get your key at https://app.arcjet.com (if omitted, falls back to safe no-op)
ARCJET_KEY=ajkey_your_arcjet_key_here

# ------------------------------------------------------------------------------
# Email Service (Nodemailer / SMTP) - Optional
# ------------------------------------------------------------------------------
# Configure if you want to send welcome emails upon signup.
# In development, Ethereal test mail is used automatically if these are omitted.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Chatify
DEFAULT_FROM=noreply@yourdomain.com
